{
  "name": "tempemail",
  "version": "1.0.0",
  "private": true,
  "description": "Disposable email platform: generate private temporary inboxes and receive real email in real time.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --conditions=react-server --env-file-if-exists=.env src/worker/main.ts",
    "build": "next build && npm run build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "start:worker": "node dist/worker.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/cli.ts migrate",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/cli.ts create-admin",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smtp": "tsx --conditions=react-server --env-file-if-exists=.env scripts/send-test-email.ts",
    "db:check": "drizzle-kit generate --name check && git diff --exit-code --stat -- drizzle && test -z \"$(git status --porcelain -- drizzle)\""
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.63.0",
    "mailparser": "3.12.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "smtp-server": "3.21.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "nodemailer": "10.2.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
