# Copy to .env and replace every placeholder. Never commit .env.
# Values below are placeholders only.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public URL of the site (also used at build time for metadata and the sitemap).
APP_URL=https://tempmail.example.com
# Host name Caddy serves and obtains a certificate for (docker-compose.yml).
APP_DOMAIN=tempmail.example.com
# At least 32 random characters, e.g. `openssl rand -base64 48`. Used to hash IPs.
SESSION_SECRET=replace-with-a-long-random-secret-value-0000000000

# PostgreSQL. docker-compose.yml builds DATABASE_URL from POSTGRES_PASSWORD.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tempemail
POSTGRES_PASSWORD=replace-with-a-strong-alphanumeric-password
DATABASE_POOL_MAX=10
# disable | require | no-verify
DATABASE_SSL=disable

# Number of reverse proxies in front of the app that append X-Forwarded-For.
# 0 for local development, 1 behind Caddy/nginx/a load balancer.
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Inbound mail: built-in SMTP server (worker)
# ---------------------------------------------------------------------------
SMTP_ENABLED=true
SMTP_BIND_HOST=0.0.0.0
SMTP_PORT=2525
# Host name announced in the SMTP greeting; should match your MX host.
SMTP_HOSTNAME=mx.example.com
# Optional STARTTLS certificate (PEM). Reloaded automatically when renewed.
SMTP_TLS_KEY_FILE=
SMTP_TLS_CERT_FILE=
SMTP_MAX_CLIENTS=200
# Set to true only behind a load balancer that sends the PROXY protocol header.
SMTP_USE_PROXY_PROTOCOL=false

# Expected MX hosts for domain verification (comma separated, wildcards allowed):
#   self-hosted:  mx.example.com
#   Mailgun:      mxa.mailgun.org,mxb.mailgun.org   (EU: mxa.eu.mailgun.org,mxb.eu.mailgun.org)
#   Cloudflare:   *.mx.cloudflare.net
MX_TARGETS=mx.example.com
# Development only: offer domains without verified MX records (a test delivery is still required).
SKIP_MX_CHECK=false

# ---------------------------------------------------------------------------
# Inbound mail: webhooks (optional, enable the ones you use)
# ---------------------------------------------------------------------------
# Shared secret for POST /api/webhooks/inbound (Cloudflare Email Worker, custom relays).
INBOUND_WEBHOOK_SECRET=
# Mailgun "HTTP webhook signing key" for POST /api/webhooks/mailgun/mime.
MAILGUN_WEBHOOK_SIGNING_KEY=
WEBHOOK_MAX_SKEW_SECONDS=300

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=8081

# ---------------------------------------------------------------------------
# First administrator (created on worker start if no admin exists)
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Legal and contact details shown on /privacy, /terms and /contact
# ---------------------------------------------------------------------------
OPERATOR_NAME=
CONTACT_EMAIL=
ABUSE_EMAIL=

# debug | info | warn | error
LOG_LEVEL=info
